<?xml version="1.0"?>
<robot name="amr_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 기본 로봇 치수 및 속성 정의 -->
  <xacro:property name="robot_length" value="0.885"/>
  <xacro:property name="robot_width" value="0.68"/>
  <xacro:property name="robot_height" value="0.52"/>
  <xacro:property name="front_wheel_radius" value="0.105"/>
  <xacro:property name="front_wheel_thickness" value="0.045"/>
  <xacro:property name="middle_wheel_radius" value="0.1025"/>
  <xacro:property name="middle_wheel_thickness" value="0.063"/>

  <!-- Base Link 정의 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <origin xyz="0 0 0.26"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <origin xyz="0 0 0.26"/>
    </collision>
    <inertial>
      <mass value="15"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <!-- 바퀴 매크로 정의 -->
  <xacro:macro name="wheel" params="wheel_name wheel_joint x y z radius thickness">
    <link name="${wheel_name}">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${thickness}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${radius}" length="${thickness}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${wheel_joint}" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_name}"/>
      <origin xyz="${x} ${y} ${z}"/>
      <axis xyz="0 1 0"/>
      <limit effort="30" velocity="10"/>
      <dynamics damping="1.0" friction="0.2"/>
    </joint>
  </xacro:macro>

  <!-- 고정된 바퀴 매크로 정의 -->
  <xacro:macro name="fixed_wheel" params="wheel_name wheel_joint x y z radius thickness">
    <link name="${wheel_name}">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${thickness}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${radius}" length="${thickness}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${wheel_joint}" type="fixed">
      <parent link="base_link"/>
      <child link="${wheel_name}"/>
      <origin xyz="${x} ${y} ${z}"/>
    </joint>
  </xacro:macro>

  <!-- 바퀴 정의 -->
  <xacro:wheel wheel_name="front_left_wheel" wheel_joint="front_left_wheel_joint" x="0.3" y="0.34" z="0.0" radius="${front_wheel_radius}" thickness="${front_wheel_thickness}"/>
  <xacro:fixed_wheel wheel_name="middle_left_wheel" wheel_joint="middle_left_wheel_joint" x="0.0" y="0.34" z="0.0" radius="${middle_wheel_radius}" thickness="${middle_wheel_thickness}"/>
  <xacro:wheel wheel_name="rear_left_wheel" wheel_joint="rear_left_wheel_joint" x="-0.3" y="0.34" z="0.0" radius="${front_wheel_radius}" thickness="${front_wheel_thickness}"/>

  <xacro:wheel wheel_name="front_right_wheel" wheel_joint="front_right_wheel_joint" x="0.3" y="-0.34" z="0.0" radius="${front_wheel_radius}" thickness="${front_wheel_thickness}"/>
  <xacro:fixed_wheel wheel_name="middle_right_wheel" wheel_joint="middle_right_wheel_joint" x="0.0" y="-0.34" z="0.0" radius="${middle_wheel_radius}" thickness="${middle_wheel_thickness}"/>
  <xacro:wheel wheel_name="rear_right_wheel" wheel_joint="rear_right_wheel_joint" x="-0.3" y="-0.34" z="0.0" radius="${front_wheel_radius}" thickness="${front_wheel_thickness}"/>

  <!-- LiDAR 센서 -->
  <link name="front_lidar">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="front_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_lidar"/>
    <origin xyz="0.4 0 0.3"/>
  </joint>

  <link name="rear_lidar">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>
  <joint name="rear_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_lidar"/>
    <origin xyz="-0.4 0 0.3"/>
  </joint>

  <!-- IMU 센서>
  <link name="imu_sensor">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <joint name="imu_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_sensor"/>
    <origin xyz="0 0 0.2"/>
  </joint-->

  <!-- 카메라 -->
  <link name="front_camera">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera"/>
    <origin xyz="0.4 0 0.5"/>
  </joint>

    <!-- [7] ROS2 Control Plugin: gazebo_ros2_control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <ros2_control name="amr_robot">
        <ros2_control_parameters>../config/ros2_control.yaml</ros2_control_parameters>
      </ros2_control>
    </plugin>
  </gazebo>


</robot>
