<?xml version="1.0"?>
<robot name="amr_robot" xmlns:xacro="http://ros.org/wiki/xacro">


  <!-- 로봇 치수 정의 -->
  <xacro:property name="robot_length" value="0.86"/>
  <xacro:property name="robot_width"  value="0.68"/>
  <xacro:property name="robot_height" value="0.11"/>
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_thickness" value="0.05"/>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="15"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.615" ixy="0" ixz="0" iyy="0.853" iyz="0" izz="1.329"/>
    </inertial>
  </link>

  <!-- 바퀴 매크로 (회전 가능) -->
  <xacro:macro name="wheel" params="wheel_name wheel_joint x y z">
    <link name="${wheel_name}">
      <visual>
        <geometry>
          <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
        </geometry>
        <origin rpy="-1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01225" ixy="0" ixz="0" iyy="0.01225" iyz="0" izz="0.0093"/>
      </inertial>
    </link>

    <joint name="${wheel_joint}" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_name}"/>
      <origin xyz="${x} ${y} ${z}"/>
      <axis xyz="0 1 0"/>
      <limit effort="30" velocity="10"/>
      <dynamics damping="1.0" friction="0.2"/>
    </joint>
  </xacro:macro>

  <!-- 6개 바퀴 정의 -->
  <xacro:wheel wheel_name="front_left_wheel"
               wheel_joint="front_left_wheel_joint"
               x="0.3" y="0.34" z="0"/>
  <xacro:wheel wheel_name="middle_left_wheel"
               wheel_joint="middle_left_wheel_joint"
               x="0.0" y="0.34" z="0"/>
  <xacro:wheel wheel_name="rear_left_wheel"
               wheel_joint="rear_left_wheel_joint"
               x="-0.3" y="0.34" z="0"/>

  <xacro:wheel wheel_name="front_right_wheel"
               wheel_joint="front_right_wheel_joint"
               x="0.3" y="-0.34" z="0"/>
  <xacro:wheel wheel_name="middle_right_wheel"
               wheel_joint="middle_right_wheel_joint"
               x="0.0" y="-0.34" z="0"/>
  <xacro:wheel wheel_name="rear_right_wheel"
               wheel_joint="rear_right_wheel_joint"
               x="-0.3" y="-0.34" z="0"/>

  <!-- Transmission (ros2_control) -->
  <transmission name="front_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="front_left_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <transmission name="middle_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="middle_left_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="middle_left_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <transmission name="rear_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="rear_left_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <transmission name="front_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="front_right_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <transmission name="middle_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="middle_right_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="middle_right_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <transmission name="rear_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_wheel_joint">
      <interfaceType>hardware_interface/VelocityJointInterface</interfaceType>
    </joint>
    <actuator name="rear_right_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- Lidar front -->
  <link name="lidar_front_link">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_front_link"/>
    <origin xyz="0.4 0 0.1"/>
  </joint>
  <gazebo reference="lidar_front_link">
    <sensor type="ray" name="front_laser">
      <update_rate>10</update_rate>
      <topicName>front_laser/scan</topicName>
      <horizontal_samples>720</horizontal_samples>
      <horizontal_min_angle>-1.57</horizontal_min_angle>
      <horizontal_max_angle>1.57</horizontal_max_angle>
      <range>
        <min>0.1</min>
        <max>30.0</max>
      </range>
    </sensor>
  </gazebo>

  <!-- Lidar rear -->
  <link name="lidar_rear_link">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="red">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_rear_link"/>
    <origin xyz="-0.4 0 0.1" rpy="0 0 3.14159"/>
  </joint>
  <gazebo reference="lidar_rear_link">
    <sensor type="ray" name="rear_laser">
      <update_rate>10</update_rate>
      <topicName>rear_laser/scan</topicName>
      <horizontal_samples>720</horizontal_samples>
      <horizontal_min_angle>-1.57</horizontal_min_angle>
      <horizontal_max_angle>1.57</horizontal_max_angle>
      <range>
        <min>0.1</min>
        <max>30.0</max>
      </range>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- Gazebo 시뮬레이터용 가상 하드웨어 인터페이스 플러그인 -->
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- 왼쪽 휠 조인트들 -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="middle_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 오른쪽 휠 조인트들 -->
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="middle_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gazebo_ros2_control plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find my_robot_description)/config/ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

</robot>